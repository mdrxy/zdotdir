#!/bin/zsh
#
# .aliases - Set whatever shell aliases you want.
#

# Work
alias lock="make lock"
alias da="dcode"
alias cl="claude"
alias f="make format"
alias lt="make lint"
alias fix="uv run --all-groups ruff check . --fix"
alias lf="f && lt"
alias lft="lf && t"
alias lfti="lf && t && ti"
alias uvs="uv sync --all-groups"
alias utc="date -u && date -u +%s"
ghpr() {
  # Wrap `gh pr checkout` to self-heal missing upstream tracking.
  #
  # `gh pr checkout` only configures `branch.<name>.remote/.merge` on the
  # *initial* checkout, and only when an existing remote matches the PR's
  # head repo. Re-checkouts of an already-local branch, or checkouts done
  # before the fork remote existed, leave the branch with no upstream
  # (which makes VSCode show "Publish Branch", etc.). After running
  # `gh pr checkout`, derive the head remote+branch from PR metadata and
  # set upstream — adding the fork as a named remote if none matches.
  gh pr checkout "$@" || return $?

  # Detached HEAD (e.g. `gh pr checkout --detach`) — nothing to track.
  git symbolic-ref -q HEAD >/dev/null || return 0

  # Already has upstream — nothing to do.
  if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    return 0
  fi

  local data head_owner head_repo head_branch
  data=$(gh pr view --json headRepositoryOwner,headRepository,headRefName 2>/dev/null) || {
    echo "ghpr: could not read PR metadata to set upstream" >&2
    return 0
  }
  head_owner=$(echo "$data" | jq -r '.headRepositoryOwner.login // empty')
  head_repo=$(echo "$data"  | jq -r '.headRepository.name // empty')
  head_branch=$(echo "$data" | jq -r '.headRefName // empty')

  if [[ -z "$head_owner" || -z "$head_repo" || -z "$head_branch" ]]; then
    echo "ghpr: incomplete PR metadata; leaving upstream unset" >&2
    return 0
  fi

  # Find a remote whose URL points to head_owner/head_repo (ssh or https form).
  local remote url found_remote=""
  local target_ssh="git@github.com:${head_owner}/${head_repo}"
  local target_https="https://github.com/${head_owner}/${head_repo}"
  for remote in $(git remote); do
    url=$(git remote get-url "$remote" 2>/dev/null)
    url="${url%.git}"
    if [[ "$url" == "$target_ssh" || "$url" == "$target_https" ]]; then
      found_remote="$remote"
      break
    fi
  done

  if [[ -z "$found_remote" ]]; then
    found_remote="$head_owner"
    if ! git remote add "$found_remote" "${target_ssh}.git" 2>/dev/null; then
      echo "ghpr: could not add remote '$found_remote' for ${head_owner}/${head_repo}" >&2
      return 0
    fi
    echo "ghpr: added remote '$found_remote' -> ${target_ssh}.git"
  fi

  git fetch "$found_remote" "$head_branch" >/dev/null 2>&1
  if git branch --set-upstream-to="${found_remote}/${head_branch}" >/dev/null 2>&1; then
    echo "ghpr: set upstream to ${found_remote}/${head_branch}"
  else
    echo "ghpr: failed to set upstream to ${found_remote}/${head_branch}" >&2
  fi
}
alias grrma='git remote | grep -v "^origin$" | xargs -I {} git remote remove {}'
t() {
  if [ $# -eq 0 ]; then
    make test
  else
    make test TEST_FILE="$1"
  fi
}
ti() {
  if [ $# -eq 0 ]; then
    make integration_tests
  else
    make integration_tests TEST_FILE="$1"
  fi
}
tti() {
  if [ $# -eq 0 ]; then
    make test && make integration_tests
  else
    make test TEST_FILE="$1" && make integration_tests TEST_FILE="$1"
  fi
}


# python
alias python=python3

# git
alias remote='git remote -v'

# Enhanced git workflow aliases
alias gfp='git fetch --prune'  # Fetch and prune deleted remote branches
alias gbd='git branch --merged | grep -v -e main -e master -e "\*" | while read -r b; do git branch -d "$b"; done'  # Delete merged branches (safe cleanup)
alias gbu='git branch --no-merged | grep -v "main\|master"'  # List unmerged branches

# Ruby - lazy loaded
chruby() {
    unset -f chruby ruby
    source /opt/homebrew/opt/chruby/share/chruby/chruby.sh
    source /opt/homebrew/opt/chruby/share/chruby/auto.sh
    chruby ruby-3.4.1
    chruby "$@"
}

ruby() {
    unset -f chruby ruby
    source /opt/homebrew/opt/chruby/share/chruby/chruby.sh
    source /opt/homebrew/opt/chruby/share/chruby/auto.sh
    chruby ruby-3.4.1
    ruby "$@"
}

# single character aliases - be sparing!
alias _=sudo
alias l=ls
alias g=git

# more ways to ls
alias la='ls -A'
alias ll='ls -lAh'
alias ldot='ls -ld .*'

# fix common typos
alias quit='exit'
alias cd..='cd ..'

# find
alias fd='find . -type d -name'
alias ff='find . -type f -name'

# url encode/decode
alias urldecode='python3 -c "import sys, urllib.parse as ul; \
    print(ul.unquote_plus(sys.argv[1]))"'
alias urlencode='python3 -c "import sys, urllib.parse as ul; \
    print (ul.quote_plus(sys.argv[1]))"'

# misc
alias zshrc='${EDITOR:-nano} "${ZDOTDIR:-$HOME}"/.zshrc'
alias zdot='cd ${ZDOTDIR:-~}'
alias ip="curl http://ipecho.net/plain; echo"

# functions

# Open local repo on GitHub
repo() {
  # Usage:
  # `repo pulls`
  # `repo pull 123`
  # `repo issues`
  # `repo issues 456`
  open "$(git config --get remote.origin.url | sed 's|git@\(.*\):\(.*\)\.git|https://\1/\2|')/$1/$2"
}

# Open current branch on GitHub
branch() {
  # Usage: `branch`
  local branch=$(git rev-parse --abbrev-ref HEAD)
  open "$(git config --get remote.origin.url | sed 's|git@\(.*\):\(.*\)\.git|https://\1/\2|; s|\.git$||')/tree/$branch"
}

# Sync `uv` environ and activate venv
function usync() {
  export UV_PROJECT_ENVIRONMENT="$(pwd)/.venv"
  uv venv 2>/dev/null
  uv sync
  source .venv/bin/activate
}


# Get a PR diff as markdown
prd() {
  local print_mode=0
  local pr_number=

  # Parse args
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--print) print_mode=1; shift ;;
      *) pr_number="$1"; shift ;;
    esac
  done

  # Determine PR number if not provided
  if [[ -z "$pr_number" ]]; then
    pr_number=$(gh pr view --json number -q .number 2>/dev/null)
    if [[ -z "$pr_number" ]]; then
      echo "Could not determine current PR. Usage: prd [-p|--print] [PR_NUMBER]"
      return 1
    fi
  fi

  if [[ $print_mode -eq 1 ]]; then
    gh pr diff "$pr_number"
  else
    local file="pr_diff_${pr_number}.md"
    if gh pr diff "$pr_number" > "$file"; then
      echo "Saved diff to $file"
    else
      return 1
    fi
  fi
}

# Export PR with comments to markdown
prmd() {
  local print_mode=0
  local pr_number=
  local filter_resolved=0
  local repo_arg=""

  # Show usage if explicit help requested
  for arg in "$@"; do
    if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
      echo "Usage: prmd [-p|--print] [-r|--filter-resolved] [-R|--repo owner/repo] [PR_NUMBER]"
      echo ""
      echo "Export a GitHub PR with comments to markdown format"
      echo ""
      echo "Options:"
      echo "  -h, --help              Show this help message"
      echo "  -p, --print             Print to stdout instead of saving to file"
      echo "  -r, --filter-resolved   Only show unresolved code comments"
      echo "  -R, --repo REPO         Specify repository (owner/repo format)"
      echo "  PR_NUMBER               PR number (optional if in current PR branch)"
      echo ""
      echo "Examples:"
      echo "  prmd                    Export current PR to file"
      echo "  prmd 123                Export PR #123 to file"
      echo "  prmd -p                 Print current PR to stdout"
      echo "  prmd -p 123             Print PR #123 to stdout"
      echo "  prmd -r                 Export current PR with only unresolved comments"
      echo "  prmd -r 123             Export PR #123 with only unresolved comments"
      echo "  prmd -R owner/repo 123  Export PR #123 from specified repository"
      return 0
    fi
  done

  # Parse args
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--print) print_mode=1; shift ;;
      -r|--filter-resolved) filter_resolved=1; shift ;;
      -R|--repo) repo_arg="$2"; shift 2 ;;
      *) pr_number="$1"; shift ;;
    esac
  done

  # Determine repository context
  if [[ -n "$repo_arg" ]]; then
    local repo_context="--repo $repo_arg"
  elif git rev-parse --git-dir >/dev/null 2>&1; then
    local repo_context=""
  else
    echo "Error: Not in a git repository and no --repo specified"
    echo "Usage: prmd [-p|--print] [-r|--filter-resolved] [-R|--repo owner/repo] [PR_NUMBER]"
    return 1
  fi

  # Determine PR number if not provided
  if [[ -z "$pr_number" ]]; then
    if [[ -n "$repo_context" ]]; then
      echo "Error: PR number required when using --repo option"
      return 1
    fi
    pr_number=$(gh pr view --json number -q .number 2>/dev/null)
    if [[ -z "$pr_number" ]]; then
      echo "Could not determine current PR. Usage: prmd [-p|--print] [-r|--filter-resolved] [-R|--repo owner/repo] [PR_NUMBER]"
      return 1
    fi
  fi

  local file="pr_${pr_number}_comments.md"
  local temp_file="/tmp/prmd_$$"

  # Get PR details - clean problematic control characters from JSON (keep newlines)
  local pr_data=$(gh pr view "$pr_number" $repo_context --json title,author,body,number,url,state,baseRefName,headRefName,createdAt,updatedAt,reviewDecision | tr -d '\000-\010\013\014\016-\037')

  if [[ -z "$pr_data" ]]; then
    echo "Error: Could not fetch PR #$pr_number"
    return 1
  fi

  # Extract PR information with better error handling
  local title=$(echo "$pr_data" | jq -r '.title // "No Title"')
  local author=$(echo "$pr_data" | jq -r '.author.login // "Unknown"')
  local body=$(echo "$pr_data" | jq -r '.body // ""' | sed 's/\r//g')
  local url=$(echo "$pr_data" | jq -r '.url // ""')
  local state=$(echo "$pr_data" | jq -r '.state // "UNKNOWN"')
  local base_branch=$(echo "$pr_data" | jq -r '.baseRefName // "unknown"')
  local head_branch=$(echo "$pr_data" | jq -r '.headRefName // "unknown"')
  local created_at=$(echo "$pr_data" | jq -r '.createdAt // ""')
  local updated_at=$(echo "$pr_data" | jq -r '.updatedAt // ""')
  local review_decision=$(echo "$pr_data" | jq -r '.reviewDecision // "PENDING"')

  # Start building output file
  {
    printf "# PR #%s: %s\n\n" "$pr_number" "$title"
    printf "**Author:** %s  \n" "$author"
    printf "**State:** %s  \n" "$state"
    printf "**Review Status:** %s  \n" "$review_decision"
    printf "**Branch:** \`%s\` → \`%s\`  \n" "$head_branch" "$base_branch"
    printf "**Created:** %s  \n" "$created_at"
    printf "**Updated:** %s  \n" "$updated_at"
    printf "**URL:** %s\n\n" "$url"

    if [[ -n "$body" && "$body" != "null" ]]; then
      printf "## Description\n\n%s\n\n" "$body"
    fi

    # Get PR reviews
    local reviews_data=$(gh pr view "$pr_number" $repo_context --json reviews | tr -d '\000-\010\013\014\016-\037')

    if [[ "$reviews_data" != "null" ]] && [[ $(echo "$reviews_data" | jq '.reviews | length' 2>/dev/null || echo 0) -gt 0 ]]; then
      printf "## Reviews\n\n"

      echo "$reviews_data" | jq -r '.reviews[] |
        "### Review by @" + .author.login + " (" + .state + ")\n" +
        "**Submitted:** " + .submittedAt + "\n\n" +
        (.body // "*(No review comment)*") + "\n"' 2>/dev/null || echo "*(Error parsing reviews)*"

      printf "\n"
    fi

    # Get review comments (code comments)
    printf "## Code Comments\n\n"

    # First save the raw comments to a temp file to avoid control character issues in pipelines
    local temp_comments="/tmp/prmd_comments_$$"
    if gh api "repos/{owner}/{repo}/pulls/$pr_number/comments" --paginate > "$temp_comments" 2>/dev/null; then
      local total_comments=$(jq -r '. | length' < "$temp_comments" 2>/dev/null || echo 0)

      if [[ "$total_comments" -gt 0 ]]; then
        local has_comments=0

        for ((i=0; i<total_comments; i++)); do
          # Extract each field separately to avoid complex jq expressions with control chars
          local in_reply_to=$(jq -r ".[$i].in_reply_to_id // empty" < "$temp_comments" 2>/dev/null)
          [[ -n "$in_reply_to" && "$in_reply_to" != "null" ]] && continue

          # If filtering resolved comments, check resolved status
          if [[ $filter_resolved -eq 1 ]]; then
            local resolved_at=$(jq -r ".[$i].resolved_at // empty" < "$temp_comments" 2>/dev/null)
            [[ -n "$resolved_at" && "$resolved_at" != "null" ]] && continue
          fi

          has_comments=1

          # Extract fields
          local file_path=$(jq -r ".[$i].path" < "$temp_comments" 2>/dev/null || echo "unknown")
          local line_num=$(jq -r ".[$i].line // .[$i].original_line // \"N/A\"" < "$temp_comments" 2>/dev/null || echo "N/A")
          local author=$(jq -r ".[$i].user.login" < "$temp_comments" 2>/dev/null || echo "unknown")
          local created_at=$(jq -r ".[$i].created_at" < "$temp_comments" 2>/dev/null || echo "unknown")
          local body=$(jq -r ".[$i].body" < "$temp_comments" 2>/dev/null || echo "No body")
          local diff_hunk=$(jq -r ".[$i].diff_hunk // empty" < "$temp_comments" 2>/dev/null)

          # Output the comment
          printf "**File:** \`%s\`\n" "$file_path"
          printf "**Line:** %s\n" "$line_num"
          printf "**Author:** @%s\n" "$author"
          printf "**Created:** %s\n\n" "$created_at"
          printf "%s\n\n" "$body"

          if [[ -n "$diff_hunk" && "$diff_hunk" != "null" && "$diff_hunk" != "" ]]; then
            printf "\`\`\`diff\n%s\n\`\`\`\n\n" "$diff_hunk"
          fi

          printf "---\n\n"
        done

        if [[ $has_comments -eq 0 ]]; then
          if [[ $filter_resolved -eq 1 ]]; then
            printf "*(No unresolved code comments)*\n\n"
          else
            printf "*(No code comments)*\n\n"
          fi
        fi
      else
        printf "*(No code comments)*\n\n"
      fi

      rm -f "$temp_comments"
    else
      printf "*(Error fetching code comments)*\n\n"
    fi

    # Get issue comments (general PR conversation)
    printf "## Conversation\n\n"

    gh api "repos/{owner}/{repo}/issues/$pr_number/comments" --paginate 2>/dev/null | \
    sed 's/\r//g' | \
    jq -r '.[] |
      "### Comment by @" + .user.login +
      (if .user.type == "Bot" then " (bot)" else "" end) + "\n" +
      "**Created:** " + .created_at + "\n\n" +
      .body + "\n"' 2>/dev/null || printf "*(No conversation or error parsing)*\n"

  } > "$temp_file"

  # Output result
  if [[ $print_mode -eq 1 ]]; then
    cat "$temp_file"
  else
    if cp "$temp_file" "$file"; then
      echo "Exported PR #$pr_number to $file"
      if [[ $filter_resolved -eq 1 ]]; then
        echo "(Filtered out resolved comments)"
      fi
    else
      echo "Error: Could not write to $file"
      rm -f "$temp_file"
      return 1
    fi
  fi

  rm -f "$temp_file"
}


# See old branches listed
alias old_b='git for-each-ref --sort=committerdate refs/heads/ --format="%(refname:short) - %(committerdate:relative)"'

# Clean up repo branches
function prune_old_b() {
  # Usage examples:
  #  prune_old_b 45             # Delete branches older than 45 days; always keep main/master
  #  prune_old_b 30 feature-x   # Also whitelist 'feature-x'
  #  prune_old_b 30 -n          # Dry run only (no deletions)
  #  prune_old_b 60 -n test bug  # Dry run with additional whitelist entries 'test' and 'bug'


  # Number of days to keep (default: 30)
  local days=${1:-30}
  shift

  # Parse flags and whitelist arguments
  local dry_run=false
  local extra_whitelist=()
  for arg in "$@"; do
    case "$arg" in
      -n|--dry-run)
        dry_run=true
        ;;
      *)
        extra_whitelist+=("$arg")
        ;;
    esac
  done

  # Always whitelist main and master, plus any extras
  local whitelist=("main" "master" "${extra_whitelist[@]}")

  # Determine cutoff date (Unix timestamp)
  local cutoff_date
  if date -v -${days}d >/dev/null 2>&1; then
    # macOS BSD date
    cutoff_date=$(date -v -${days}d +%s)
  else
    # GNU date (Linux)
    cutoff_date=$(date -d "-${days} days" +%s)
  fi

  local current_branch=$(git rev-parse --abbrev-ref HEAD)

  echo "🧹 Pruning branches older than ${days} days..."
  echo "🔒 Whitelist: ${whitelist[*]}"
  $dry_run && echo "🌐 Dry run mode: no branches will be deleted"

  git for-each-ref --format='%(refname:short) %(committerdate:unix)' refs/heads/ | while read branch date; do
    # Skip current branch
    [[ "$branch" == "$current_branch" ]] && continue

    # Skip whitelisted branches
    for w in "${whitelist[@]}"; do
      [[ "$branch" == "$w" ]] && continue 2
    done

    # Check age and delete or dry-run
    if (( date < cutoff_date )); then
      if $dry_run; then
        echo "🗑 [DRY RUN] Would delete: $branch (last commit over ${days} days ago)"
      else
        echo "🗑 Deleting: $branch (last commit over ${days} days ago)"
        git branch -D "$branch"
      fi
    fi
  done
}


function pfi() {
  # Fetch and check out a branch from a fork
  # e.g. pull code from someone elses fork for PR reviews and edits

  if [ -z "$1" ]; then
    echo "Usage: pull-fork <author/contributor> [branch]"
    return 1
  fi
  author="$1"
  branch="${2:-main}"
  repo=$(basename -s .git "$(git config --get remote.origin.url)")
  remote_url="https://github.com/${author}/${repo}.git"
  git remote add "$author" "$remote_url" 2>/dev/null || git remote set-url "$author" "$remote_url"
  git fetch "$author"
  git checkout -B "$author/$branch" "$author/$branch"
}

function pf() {
  # Fetch and check out a branch from a fork using {author}:{branch/name}
  # Example: pull-fork alice:fix:docs

  if [ -z "$1" ]; then
    echo "Usage: pf {author}:{branch}"
    return 1
  fi

  IFS=':' read -r author branch <<< "$1"

  if [ -z "$author" ] || [ -z "$branch" ]; then
    echo "Invalid format. Expected {author}:{branch}, got '$1'"
    return 1
  fi

  # Reconstruct full branch name in case there were extra colons
  branch="${1#${author}:}"

  repo=$(basename -s .git "$(git config --get remote.origin.url)")
  remote_url="https://github.com/${author}/${repo}.git"

  git remote add "$author" "$remote_url" 2>/dev/null || git remote set-url "$author" "$remote_url"
  git fetch "$author"
  git checkout -B "$author/$branch" "$author/$branch"
}
